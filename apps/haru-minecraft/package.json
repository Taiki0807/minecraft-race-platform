{
  "name": "haru-minecraft",
  "version": "0.1.0",
  "private": true,
  "description": "ハル・マイクラ連携契約 v1 の実装: bridge / brain / skills / memory",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
