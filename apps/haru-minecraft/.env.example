# ハル・マイクラ連携契約 v1 の設定。すべて空値のテンプレート。
# Secretはここに書かず、.env (gitignore済み) にのみ書くこと。

# (A) Creator Studio 管理画面。
# このプロセスはProxmoxで動き、Creator StudioはMacで動くため、localhostでは届かない。
# Mac側の実アドレス(Tailscaleホスト名等)を入れる。
STUDIO_BASE_URL=http://<Macの実アドレス>:3100
STUDIO_TOKEN=

# (A) brain自身の制御サーバー
BRAIN_PORT=3200
BRAIN_TOKEN=

# (B) LLM: "ollama" または "home-llm"
LLM_PROVIDER=home-llm

# ollama = Windows側のFastAPI GPU推論サービス(OpenAI互換)。fastapi-llm-service-spec.md 参照
OLLAMA_BASE_URL=http://<Windowsの実アドレス>:<ポート>
OLLAMA_MODEL=<担当者から受け取るモデル名>
OLLAMA_TOKEN=

# Creator Studio の lib/ai/local-llm.ts と同じ実体
LOCAL_LLM_URL=https://chat.hosokawa-lab.dev
LOCAL_LLM_TOKEN=

LLM_TIMEOUT_MS=60000

# (D) memory
HARU_MINECRAFT_DB_PATH=data/haru-minecraft.db
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=nomic-embed-text

# (C) ゲーム接続。Mineflayer本体をこのプロセス内で直接使う。
# レース大会用と同じPaperサーバー(1.21.9)ではなく、ハル専用・常時稼働の別インスタンス
# (Tailscaleホスト名 haru-minecraft, terraform/proxmoxのharu_worker + helm/haru-server)。
MC_HOST=haru-minecraft
MC_PORT=25565
MC_USERNAME=Haru
MC_AUTH=offline

# 暴走ガード
SESSION_MAX_MINUTES=120
SESSIONS_PER_DAY_MAX=2
DECISION_INTERVAL_MIN_MS=8000
STATUS_INTERVAL_MS=30000
SAME_FAILURE_LIMIT=4

HARU_MINECRAFT_LOG_DIR=logs

# Haruの人格プロンプト(Creator Studio側の既存機能のものを流用する想定)
HARU_PERSONA_PROMPT=
